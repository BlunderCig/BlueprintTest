blueprint:
  name: "3D Printing Cost & History Tracker (Calendar Edition)"
  description: |
    Track the exact filament, energy cost, and accurate print duration of each 3D print.
    Bridges Moonraker/Klipper, Spoolman, and any Energy Monitor to a native Home Assistant Calendar.
    
    ⚠️ **SETUP REQUIREMENT:** You must manually create these two items via the UI before configuring:
    1. A 'Local Calendar' integration named for your print history.
    2. A single `input_text` helper (e.g. '3D Print Snapshot Buffer') to temporarily store start metadata.
    3. (Optional) An `input_number` helper to input energy cost per kwh if you don't have a dynamic provider entity.
  domain: automation
  input:
    # Printer Sensors
    printer_state_sensor:
      name: Printer Current Print State
      description: Select the Current Print State Sensor (not Printer State).
      selector:
        entity:
          domain: sensor
    printer_spool_id_sensor:
      name: Spool ID Sensor
      description: Select the printer's Spool ID Sensor.
      selector:
        entity:
          domain: sensor
    printer_filename_sensor:
      name: Printer Filename Sensor
      description: Select the printer's Filename Sensor.
      selector:
        entity:
          domain: sensor

    # Energy Monitor & Electricity Cost
    energy_monitor:
      name: Energy Monitor
      description: The total accumulated energy sensor (kWh) from your energy monitoring device (e.g. smart plug, CT clamps).
      selector:
        entity:
          domain: sensor
    electricity_cost_entity:
      name: Electricity Cost per kWh
      description: Select either an input_number helper OR a dynamic sensor entity (e.g., utility rate integration).
      selector:
        entity:
          domain:
            - input_number
            - sensor

    # Localization
    currency_symbol:
      name: Currency Symbol
      description: Type the currency symbol you want used in your text log strings (e.g. £, $, €, ¥).
      default: "£"
      selector:
        text:

    # History Storage
    history_calendar:
      name: History Calendar
      description: Select the Local Calendar you created to store your print logs.
      selector:
        entity:
          domain: calendar

    # Single Snapshot Helper
    helper_start_snapshot:
      name: Start Snapshot Helper
      description: A single input_text helper used to temporarily store starting energy, weight, time, and filename as JSON.
      selector:
        entity:
          domain: input_text

mode: restart

trigger:
  - platform: state
    entity_id: !input printer_state_sensor
    to: "printing"
    id: "start"
  - platform: state
    entity_id: !input printer_state_sensor
    from: "printing"
    id: "end"

action:
  # Bring blueprint inputs into global template scope
  - variables:
      printer_spool_id_sensor: !input printer_spool_id_sensor
      printer_filename_sensor: !input printer_filename_sensor
      energy_monitor: !input energy_monitor
      electricity_cost_entity: !input electricity_cost_entity
      currency_symbol: !input currency_symbol
      helper_start_snapshot: !input helper_start_snapshot

  - choose:
      # ==========================================
      # SEQUENCE A: PRINT START
      # ==========================================
      - conditions:
          - condition: trigger
            id: "start"
        sequence:
          # Force sync Spoolman to ensure starting weight is 100% fresh
          - action: homeassistant.update_entity
            target:
              entity_id: "sensor.spoolman_spool_{{ states(printer_spool_id_sensor) | int(0) }}_used_weight"
            data: {}
          - delay: "00:00:02"
          
          # Bundle all 4 start snapshots into a JSON string inside 1 helper
          - action: input_text.set_value
            target:
              entity_id: !input helper_start_snapshot
            data:
              value: >-
                {% set spool_id = states(printer_spool_id_sensor) | int(0) %}
                {% set weight = states('sensor.spoolman_spool_' ~ spool_id ~ '_used_weight') | float(0) %}
                {% set energy = states(energy_monitor) | float(0) %}
                {% set fname = state_attr(printer_filename_sensor, 'filename') %}
                {% set clean_fname = (fname if fname not in [None, '', 'unknown', 'None'] else '3D Print') | string | truncate(50, true, '') %}
                {{ {
                  "e": energy,
                  "w": weight,
                  "t": now().isoformat(),
                  "f": clean_fname
                } | to_json }}

      # ==========================================
      # SEQUENCE B: PRINT END
      # ==========================================
      - conditions:
          - condition: trigger
            id: "end"
          - condition: template
            value_template: "{{ trigger.to_state.state in ['complete', 'finished'] }}"
        sequence:
          - delay: "00:00:10"
          
          # Force sync Spoolman to get the absolute final printed weight
          - action: homeassistant.update_entity
            target:
              entity_id: "sensor.spoolman_spool_{{ states(printer_spool_id_sensor) | int(0) }}_used_weight"
            data: {}
              
          - variables:
              # --- UNPACK JSON SNAPSHOT ---
              snapshot: "{{ states(helper_start_snapshot) | from_json(default={}) }}"
              start_kwh: "{{ snapshot.get('e', 0) | float(0) }}"
              start_weight: "{{ snapshot.get('w', 0) | float(0) }}"
              start_timestamp: "{{ snapshot.get('t', now().isoformat()) }}"
              print_name: "{{ snapshot.get('f', '3D Print') }}"

              # --- ENERGY MATH ---
              end_kwh: "{{ states(energy_monitor) | float(0) }}"
              kwh_used: "{{ (end_kwh - start_kwh) | round(3) }}"
              elec_rate: "{{ states(electricity_cost_entity) | float(0.15) }}"
              elec_cost: "{{ (kwh_used * elec_rate) | round(2) }}"
              
              # --- FILAMENT MATH ---
              active_spool_id: "{{ states(printer_spool_id_sensor) | int(0) }}"
              end_weight: "{{ states('sensor.spoolman_spool_' ~ active_spool_id ~ '_used_weight') | float(0) }}"
              grams_used: "{{ (end_weight - start_weight) | round(1) }}"
              
              # --- TOTAL COST MATH ---
              spool_price: "{{ states('sensor.spoolman_spool_' ~ active_spool_id ~ '_price') | float(0) }}"
              spool_initial_weight: "{{ states('sensor.spoolman_spool_' ~ active_spool_id ~ '_filament_weight') | float(1000) }}"
              cost_per_gram: "{{ spool_price / (spool_initial_weight if spool_initial_weight > 0 else 1000) }}"
              filament_cost: "{{ (grams_used * cost_per_gram) | round(2) }}"
              total_cost: "{{ (elec_cost + filament_cost) | round(2) }}"

          # Log directly as a calendar event with accurate start and end times
          - action: calendar.create_event
            target:
              entity_id: !input history_calendar
            data:
              summary: "{{ print_name }} ({{ currency_symbol }}{{ total_cost }})"
              description: >-
                Filament Used: {{ grams_used }}g ({{ currency_symbol }}{{ filament_cost }})
                Power Consumed: {{ kwh_used }} kWh ({{ currency_symbol }}{{ elec_cost }})
                Spool ID Used: #{{ active_spool_id }}
              start_date_time: "{{ start_timestamp }}"
              end_date_time: "{{ now().isoformat() }}"
